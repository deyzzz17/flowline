DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional — live updates via Ably (https://ably.com, free plan is enough).
# Without it the app falls back to polling every 30s (live data) / 2 min (rarely changing data).
# Use a key with the "publish", "subscribe" and "token" capabilities; server-only, never NEXT_PUBLIC_.
ABLY_API_KEY=
